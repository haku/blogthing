#!/usr/bin/env python

import argparse
import json
import os
import pathlib
import re
import requests
import sys
import tempfile
import tiptapy

parser = argparse.ArgumentParser(allow_abbrev=False)
parser.add_argument('--host', required=True, help='blogthing URL.')
parser.add_argument('--tag', action='append', required=True, help='Tags to include.')
parser.add_argument('--output', type=pathlib.Path, required=True, help='Directory to write output.')
parser.add_argument('--delete', action="store_true", help='Delete output files not generated by this run.')
args = parser.parse_args()

def apiUrl(path):
  # TODO fix slashes etc
  return f"{args.host}{path}"

def apiGet(path, params=None):
  res = requests.get(apiUrl(path), params=params, timeout=30)
  if res.status_code == 200:
    return res.json()
  raise Exception(f"HTTP error: {res}")

def getThingsList():
  return apiGet("/api/things", {"t": args.tag})

def getThing(thing_id):
  return apiGet(f"/api/things/{thing_id}")

def renderHtml(thing_json):
  class Config:
    DOMAIN = "example.org"
  renderer = tiptapy.BaseDoc(Config)
  return renderer.render(thing_json)

def safeWriteTextFile(text, path):
  with tempfile.NamedTemporaryFile(
      dir=path.parent,
      delete_on_close=False,
      ) as tmp:
    tmp.write(text.encode('utf-8'))
    tmp.close()
    os.replace(tmp.name, path)

def fixTiptapJson(doc):
  def fix_json(j):
    if isinstance(j, dict):
      for k, v in j.copy().items():
        if k == "alt" and v is None:
          del j[k]
        else:
          fix_json(v)
    elif isinstance(j, list):
      for v in j:
        fix_json(v)
  fix_json(doc)


out_dir = args.output
if not out_dir.exists():
  print(f"Output directory does not exist: {out_dir}")
  sys.exit(1)

index = getThingsList()
index = [i for i in index if i['published'] == True]

out_keys = set(['id', 'updated', 'title', 'tags'])
out_index = [{k:v for k,v in t.items() if k in out_keys} for t in index]
safeWriteTextFile(json.dumps(out_index), out_dir / "index.json")

OUT_FILE_PATTERN = re.compile(r"^thing-[0-9]+\.html$")

written_files = []
for i in index:
  tid = i['id']
  thing = getThing(tid)

  out_file = out_dir / f"thing-{tid}.html"
  print(f"{out_file}: {i['title']}")
  if not OUT_FILE_PATTERN.match(out_file.name):
    raise Exception("Invalid name.")

  fixTiptapJson(thing)
  html = renderHtml(thing)
  safeWriteTextFile(html, out_file)
  written_files.append(out_file)

existing_files = [f for f in out_dir.iterdir() if f.is_file()]
old_files = [
    f for f in existing_files
    if OUT_FILE_PATTERN.match(f.name) and f not in written_files
]
if args.delete:
  for f in old_files:
    print(f"rm: {f}")
    f.unlink()
else:
  print(f"Old files you should delete: {len(old_files)}")
